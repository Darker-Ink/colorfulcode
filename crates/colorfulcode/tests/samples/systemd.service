# Web application service
[Unit]
Description=Colorful web service (%i)
Documentation=https://example.com/docs man:colorful(8)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=notify
User=colorful
Group=colorful
WorkingDirectory=/srv/colorful
Environment="NODE_ENV=production" "PORT=8080"
EnvironmentFile=-/etc/colorful/env
ExecStartPre=/usr/bin/colorful migrate --database ${DATABASE_URL}
ExecStart=/usr/bin/node /srv/colorful/server.js --port $PORT
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30
LimitNOFILE=65536
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/colorful
MemoryMax=512M

[Install]
WantedBy=multi-user.target
