!!! 5
-# app/views/posts/index.html.haml
%html{lang: "en"}
  %head
    %title= @title || "Posts"
    :css
      .post { margin: 0 auto; }
  %body#main.page
    / An HTML comment
    %h1.title Posts (#{@posts.count})
    - if @posts.any?
      %ul.posts
        - @posts.each_with_index do |post, i|
          %li{class: i.even? ? "even" : "odd", data: {id: post.id}}
            %a(href="/posts/#{post.id}" title=post.title)= post.title
            %span.date= post.created_at.strftime("%Y-%m-%d")
            != post.body_html
    - else
      %p.empty No posts yet.
    %br/
    %p<
      Text without surrounding whitespace.
    \= not ruby, just text
    %footer
      &copy; 2024 #{site_name}
    :javascript
      console.log("loaded", 42);
    ~ preserve_code(@snippet)
