# Database settings
DATABASE_URL=postgres://user:pass@localhost:5432/app
DB_POOL=10
DEBUG=true
export API_KEY="sk-12345\nabc"
SECRET='raw $NOT_EXPANDED value'
GREETING="Hello ${USER}, home is $HOME"
EMPTY=
RATIO=0.25
PLAIN=some value # trailing comment
MULTI="first line
second line"
APP_NAME=my-app

# Feature flags
FEATURE_SEARCH=on
FEATURE_BETA=false
LOG_LEVEL=info
REDIS_URL=redis://cache:6379/0
BASE_DIR=/srv/${APP_NAME}/current
PRIVATE_KEY="-----BEGIN KEY-----\nMIIBOgIBAAJB\n-----END KEY-----"
SPACED = value with spaces
COMMAND=`date +%s`
PORT=8080
