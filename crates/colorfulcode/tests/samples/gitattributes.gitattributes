# Normalize line endings
* text=auto eol=lf

# Scripts must keep LF, batch files CRLF
*.sh        text eol=lf
*.{bat,cmd} text eol=crlf
*.ps1       text working-tree-encoding=UTF-16LE

# Binary assets
[attr]bin   -diff -merge -text
*.png       bin
*.jpg       bin
*.woff2     binary

# Language specific diffs
*.rs        diff=rust
*.py        diff=python
*.md        diff=markdown linguist-documentation

# Large files
assets/**/*.psd filter=lfs diff=lfs merge=lfs -text
docs/generated/** linguist-generated !export-ignore
/vendor/    linguist-vendored
Cargo.lock  -diff merge=binary
