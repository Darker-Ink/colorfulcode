# People and the projects they work on
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX :     <http://example.org/>
BASE <http://example.org/base/>

SELECT DISTINCT ?name ?email (COUNT(?project) AS ?projects)
FROM <http://example.org/graph>
WHERE {
  ?person a foaf:Person ;
          foaf:name ?name ;
          :worksOn ?project .
  OPTIONAL { ?person foaf:mbox ?email }
  ?project :started ?date ;
           rdf:type :Project .
  FILTER (?date >= "2020-01-01"^^xsd:date && lang(?name) = "en")
  FILTER NOT EXISTS { ?person :retired true }
  FILTER regex(?name, "^A", "i")
  BIND (year(?date) AS ?year)
  VALUES ?status { "active"@en 'paused' }
  ?project :budget ?budget .
  FILTER (?budget > 1000.50 || ?budget < 10)
  _:b0 :label """A long
    multi-line literal""" .
}
GROUP BY ?name ?email
HAVING (COUNT(?project) > 2)
ORDER BY DESC(?projects) ?name
LIMIT 10
OFFSET 0

INSERT DATA {
  GRAPH <http://example.org/g1> {
    :alice foaf:knows :bob ;
           foaf:age 42 .
  }
}
