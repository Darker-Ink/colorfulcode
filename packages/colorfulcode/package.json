{
  "name": "colorfulcode",
  "version": "0.2.0",
  "description": "Fast syntax highlighting for a lot of languages, powered by Rust and WebAssembly",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Darker-Ink/colorfulcode.git",
    "directory": "packages/colorfulcode"
  },
  "keywords": [
    "syntax",
    "highlighting",
    "highlighter",
    "react",
    "wasm",
    "code"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./common": {
      "types": "./dist/common.d.ts",
      "default": "./dist/common.js"
    },
    "./common/react": {
      "types": "./dist/common-react.d.ts",
      "default": "./dist/common-react.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    },
    "./web/react": {
      "types": "./dist/web-react.d.ts",
      "default": "./dist/web-react.js"
    },
    "./themes": {
      "types": "./dist/themes.d.ts",
      "default": "./dist/themes.js"
    },
    "./styles.css": "./dist/styles.css",
    "./css/*": "./dist/css/*",
    "./colorfulcode.wasm": "./dist/colorfulcode.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
